# Docker Compose settings for SupplyDesk
# Copy this file to .env before running Docker if you want custom values.

# Host port for the web app. Open http://localhost:3000 by default.
APP_PORT=3000

# PostgreSQL is started automatically by docker compose.
# Change this password before running a shared or public server.
POSTGRES_DB=supplydesk
POSTGRES_USER=supplydesk
POSTGRES_PASSWORD=change_me_before_use
